<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{FB0979F4-8B3F-4CB7-9F0B-89C5DCF00473}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>RemoteTechWormholeBridge.Contracts</RootNamespace>
    <AssemblyName>RemoteTechWormholeBridge.Contracts</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <KspRoot Condition=" '$(KspRoot)' == '' ">$(KSP_ROOT)</KspRoot>
    <KspManagedDir Condition=" Exists('$(KspRoot)/KSP_x64_Data/Managed') ">$(KspRoot)/KSP_x64_Data/Managed</KspManagedDir>
    <KspManagedDir Condition=" '$(KspManagedDir)' == '' and Exists('$(KspRoot)/KSP_Data/Managed') ">$(KspRoot)/KSP_Data/Managed</KspManagedDir>
    <KspGameDataDir>$(KspRoot)/GameData</KspGameDataDir>
    <PackageOutputDir>../../build/GameData/RemoteTechWormholeBridge</PackageOutputDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(PackageOutputDir)/Plugins/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(PackageOutputDir)/Plugins/</OutputPath>
  </PropertyGroup>
  <Target Name="ValidateKspReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition=" '$(KspRoot)' == '' " Text="Set KSP_ROOT or pass /p:KspRoot=/path/to/Kerbal Space Program." />
    <Error Condition=" !Exists('$(KspManagedDir)/Assembly-CSharp.dll') " Text="Missing KSP reference: $(KspManagedDir)/Assembly-CSharp.dll" />
    <Error Condition=" !Exists('$(KspGameDataDir)/ContractConfigurator/ContractConfigurator.dll') " Text="Missing optional build reference: ContractConfigurator.dll" />
    <Error Condition=" !Exists('$(KspGameDataDir)/RemoteTech/Plugins/RemoteTech.dll') " Text="Missing RemoteTech reference under $(KspGameDataDir)." />
  </Target>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManagedDir)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ContractConfigurator">
      <HintPath>$(KspGameDataDir)/ContractConfigurator/ContractConfigurator.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RemoteTech">
      <HintPath>$(KspGameDataDir)/RemoteTech/Plugins/RemoteTech.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RemoteTechWormholeBridge/RemoteTechWormholeBridge.csproj">
      <Project>{E806D41B-E14A-4B69-B180-8B39D0DD610C}</Project>
      <Name>RemoteTechWormholeBridge</Name>
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ContractsLog.cs" />
    <Compile Include="Parameters/RTWBGatewayParameter.cs" />
    <Compile Include="Parameters/RTWBLinkParameter.cs" />
    <Compile Include="Parameters/RTWBStableConnectionParameter.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="RTWBContractEvents.cs" />
    <Compile Include="RTWBContractServices.cs" />
    <Compile Include="RTWBExpressionParser.cs" />
    <Compile Include="RTWBPairAvailableRequirement.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets" />
</Project>
