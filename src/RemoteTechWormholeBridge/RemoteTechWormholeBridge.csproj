<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{E806D41B-E14A-4B69-B180-8B39D0DD610C}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>RemoteTechWormholeBridge</RootNamespace>
    <AssemblyName>RemoteTechWormholeBridge</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <KspRoot Condition=" '$(KspRoot)' == '' ">$(KSP_ROOT)</KspRoot>
    <KspManagedDir Condition=" Exists('$(KspRoot)/KSP_x64_Data/Managed') ">$(KspRoot)/KSP_x64_Data/Managed</KspManagedDir>
    <KspManagedDir Condition=" '$(KspManagedDir)' == '' and Exists('$(KspRoot)/KSP_Data/Managed') ">$(KspRoot)/KSP_Data/Managed</KspManagedDir>
    <KspGameDataDir>$(KspRoot)/GameData</KspGameDataDir>
    <PackageOutputDir>../../build/GameData/RemoteTechWormholeBridge</PackageOutputDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(PackageOutputDir)/Plugins/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(PackageOutputDir)/Plugins/</OutputPath>
  </PropertyGroup>

  <Target Name="ValidateKspReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition=" '$(KspRoot)' == '' "
           Text="Set KSP_ROOT or pass /p:KspRoot=/path/to/Kerbal Space Program." />
    <Error Condition=" !Exists('$(KspManagedDir)/Assembly-CSharp.dll') "
           Text="Missing KSP reference: $(KspManagedDir)/Assembly-CSharp.dll" />
    <Error Condition=" !Exists('$(KspManagedDir)/UnityEngine.dll') "
           Text="Missing Unity reference: $(KspManagedDir)/UnityEngine.dll" />
    <Error Condition=" !Exists('$(KspManagedDir)/UnityEngine.CoreModule.dll') "
           Text="Missing Unity reference: $(KspManagedDir)/UnityEngine.CoreModule.dll" />
    <Error Condition=" !Exists('$(KspGameDataDir)/RemoteTech/Plugins/RemoteTech.dll') "
           Text="Missing RemoteTech reference under $(KspGameDataDir)." />
    <Error Condition=" !Exists('$(KspGameDataDir)/KopernicusExpansion/Plugins/KEX-Wormholes.dll') "
           Text="Missing KEX-Wormholes reference under $(KspGameDataDir)." />
    <Error Condition=" !Exists('$(KspGameDataDir)/000_Harmony/0Harmony.dll') "
           Text="Missing Harmony reference under $(KspGameDataDir)." />
  </Target>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManagedDir)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RemoteTech">
      <HintPath>$(KspGameDataDir)/RemoteTech/Plugins/RemoteTech.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="KEX-Wormholes">
      <HintPath>$(KspGameDataDir)/KopernicusExpansion/Plugins/KEX-Wormholes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(KspGameDataDir)/000_Harmony/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Bootstrap/DiagnosticController.cs" />
    <Compile Include="Bootstrap/HarmonyBootstrap.cs" />
    <Compile Include="Core/AssemblyVersions.cs" />
    <Compile Include="Core/Log.cs" />
    <Compile Include="Diagnostics/OrbitSnapshot.cs" />
    <Compile Include="Diagnostics/WormholeJumpDiagnostics.cs" />
    <Compile Include="KEX/KexWormholeCatalog.cs" />
    <Compile Include="Modules/ModuleRTWormholeBridge.cs" />
    <Compile Include="RemoteTech/RemoteTechEndpointScanner.cs" />
    <Compile Include="RemoteTech/WormholeCoverageScanner.cs" />
    <Compile Include="RemoteTech/WormholeNetworkIntegration.cs" />
    <Compile Include="Rendering/WormholeRenderManager.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="../RemoteTechWormholeBridge.Core/RegistryIssue.cs">
      <Link>Domain/RegistryIssue.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Wormholes/WormholeBodyDescriptor.cs">
      <Link>Domain/Wormholes/WormholeBodyDescriptor.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Wormholes/WormholePairDescriptor.cs">
      <Link>Domain/Wormholes/WormholePairDescriptor.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Wormholes/WormholeRegistry.cs">
      <Link>Domain/Wormholes/WormholeRegistry.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Endpoints/BridgeOperationalBand.cs">
      <Link>Domain/Endpoints/BridgeOperationalBand.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Endpoints/EndpointDescriptor.cs">
      <Link>Domain/Endpoints/EndpointDescriptor.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Endpoints/EndpointFailureReason.cs">
      <Link>Domain/Endpoints/EndpointFailureReason.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Endpoints/EndpointRegistry.cs">
      <Link>Domain/Endpoints/EndpointRegistry.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Geometry/KspCoordinateFrames.cs">
      <Link>Domain/Geometry/KspCoordinateFrames.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Geometry/Vector3Value.cs">
      <Link>Domain/Geometry/Vector3Value.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Geometry/WormholeConeCoverage.cs">
      <Link>Domain/Geometry/WormholeConeCoverage.cs</Link>
    </Compile>
    <Compile Include="../RemoteTechWormholeBridge.Core/Routing/BridgeRouteVisibility.cs">
      <Link>Domain/Routing/BridgeRouteVisibility.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageFile Include="../../packaging/GameData/**/*.*" />
  </ItemGroup>

  <Target Name="CopyPackageFiles" AfterTargets="Build">
    <Copy SourceFiles="@(PackageFile)"
          DestinationFiles="@(PackageFile->'../../build/GameData/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets" />
</Project>
